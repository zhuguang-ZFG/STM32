{
  "name": "mcu-road",
  "version": "0.1.0",
  "private": true,
  "description": "通往单片机之路：寄存器级 STM32 + ESP32-S3 深度教学",
  "license": "Apache-2.0",
  "scripts": {
    "docs:dev": "npm run docs:gen && vitepress dev docs",
    "docs:build": "npm run guide:check && npm run docs:gen && vitepress build docs",
    "guide:generate": "node scripts/book-guide/generate.mjs",
    "guide:check": "node scripts/book-guide/generate.mjs --check",
    "cards:render": "node scripts/social-cards/render.mjs",
    "cards:check": "node scripts/social-cards/render.mjs --check",
    "docs:preview": "vitepress preview docs",
    "anim:lint": "node scripts/anim-lint.mjs",
    "anim:audit": "node scripts/anim-audit.mjs",
    "docs:gen": "node scripts/gen-progress.mjs",
    "readme:sync": "node scripts/gen-progress.mjs --readme",
    "readme:check": "node scripts/gen-progress.mjs --readme --check",
    "links:check": "node scripts/links-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "pages:check": "node scripts/pages-check.mjs",
    "search:check": "node scripts/search-check.mjs",
    "nav:check": "node scripts/nav-check.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "a11y:check": "node scripts/a11y-check.mjs",
    "reading:check": "node scripts/reading-time.mjs --check",
    "projects:check": "node scripts/project-catalog.mjs",
    "video:lint": "node video/src/cli.mjs lint",
    "video:test": "node --test \"video/tests/**/*.test.mjs\"",
    "video:check": "node video/src/cli.mjs check",
    "video:cover": "node video/src/cli.mjs cover",
    "video:pack": "node video/src/cli.mjs pack",
    "video:build": "node video/src/cli.mjs build",
    "video:numbers": "node video/src/cli.mjs numbers",
    "video:calib": "node video/src/cli.mjs calib",
    "test": "node --test tests/*.test.mjs",
    "firmware:check": "node scripts/check-firmware.mjs",
    "quality": "npm run test && npm run projects:check && npm run docs:build && npm run anim:lint && npm run readme:check && npm run reading:check && npm run links:check && npm run docs:check && npm run nav:check && npm run seo:check && npm run perf:budget && npm run a11y:check && npm run pages:check && npm run search:check",
    "test:browser": "playwright test",
    "site:measure": "node scripts/measure-site.mjs",
    "book:check": "python mcu-book/build_html.py --check",
    "book:html": "python mcu-book/build_html.py",
    "book:pdf": "python mcu-book/build_print.py",
    "book:pdfcheck": "python mcu-book/check_pdf.py",
    "book:pack": "python mcu-book/publish_downloads.py --out-dir .temp/book-downloads"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ffmpeg-static": "^5.3.0",
    "minisearch": "^7.2.0",
    "pagedjs": "^0.4.3",
    "puppeteer": "^25.13.0",
    "vitepress": "^1.6.3",
    "yaml": "^2.8.3"
  }
}
