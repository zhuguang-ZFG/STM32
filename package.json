{
  "name": "stm32-merged-book",
  "version": "0.1.0",
  "private": true,
  "description": "通往单片机之路：双书合并后的单一站点与书稿（VitePress 站点 / 跳转存根 / 冒烟与外链门）",
  "license": "SEE LICENSE IN mcu/LICENSE",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "site:stubs": "node scripts/legacy-redirects.mjs --mapping plans/2026-11-12-merged-book/mapping.json --manifest docs/manifest.json --out .temp/legacy-stubs",
    "site:assemble": "node scripts/site-assemble.mjs --dist docs/.vitepress/dist --stubs .temp/legacy-stubs --out .temp/pages-site",
    "site:smoke": "node scripts/site-smoke.mjs --root .temp/pages-site --mount /STM32",
    "site:links": "node scripts/check-external-links.mjs --root docs/.vitepress/dist --retries 3",
    "site:build": "npm run docs:build && npm run site:pages && npm run site:dims && npm run site:images && npm run site:prune && npm run site:stubs && npm run site:assemble",
    "site:pages": "node scripts/check-site-pages.mjs --dist docs/.vitepress/dist",
    "site:images": "node scripts/check-site-images.mjs --dist docs/.vitepress/dist",
    "site:prune": "node scripts/prune-site-assets.mjs --dist docs/.vitepress/dist",
    "site:dims": "node scripts/sync-scene-dims.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vitepress": "^1.6.4"
  }
}
