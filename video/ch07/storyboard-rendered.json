    {
      "scene_id": "ch07-s03",
      "title": "线与：谁按谁是低",
      "purpose": "mechanism",
      "prerequisite": [
        "ch07-s02"
      ],
      "narration": "挂在同一条线上的器件，谁都不按，线就是高；任何一个按下去，线就是低，这叫线与。所以 I2C 不怕两个器件打架：没人会往线上推高电平，最多是两个人一起按。",
      "on_screen": [
