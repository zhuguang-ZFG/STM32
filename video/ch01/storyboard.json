    {
      "scene_id": "ch01-s09",
      "title": "外设中断入口不要直接乘 4",
      "purpose": "failure",
      "prerequisite": [
        "ch01-s01",
        "ch01-s02",
        "ch01-s03",
        "ch01-s04",
        "ch01-s05",
        "ch01-s06",
        "ch01-s07",
        "ch01-s08"
      ],
      "narration": "外设中断入口不能直接拿 IRQn 乘 4 再加 0x08000000。前面还有 16 个系统异常，入口应是 VTOR + 4×(IRQn+16)。算错就跳到错误地址。",
      "on_screen": [
        "不是 0x08000000+4×IRQn",
        "而是 VTOR+4×(IRQn+16)",
        "算错跳错地址"
      ],
      "visual_source": "diagrams/sample-01-swd-vectors.svg",
      "fact_source": [
        "docs/01-开发环境搭建.md#原理与适用范围"
      ],
      "memory_anchor": "中断入口要加 16",
      "evidence_type": "failure"
    },
    {
      "scene_id": "ch01-s10",
      "title": "BOOT1=0 是系统存储器",
      "purpose": "failure",
      "prerequisite": [
        "ch01-s01",
        "ch01-s02",
